[Unit]
Description=AddInvoice Ops — web konsolu (ops.addinvoice.dk, 127.0.0.1:7332)
After=network.target addinvoice-ops-agent.service postgresql@16-main.service
Wants=addinvoice-ops-agent.service

[Service]
Type=simple
User=addinvoice-ops
Group=addinvoice-ops
WorkingDirectory=/var/www/addinvoice-ops
EnvironmentFile=/etc/addinvoice-ops/env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 7332 -H 127.0.0.1
Restart=always
RestartSec=3
# Root olmayan süreç: uygulama ağacı root'a ait ve salt-okunur; yalnız veri dizini yazılabilir.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/addinvoice-ops
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
